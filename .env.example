# Warehouse operator connection settings only. Never put tokens/passwords here.
# Fill these two values in your private gwos-data/.env; use a bare hostname.
GROWTHOS_TRINO_HOST=
GROWTHOS_TRINO_USER=
GROWTHOS_TRINO_CATALOG=hive
GROWTHOS_TRINO_PORT=443
# Writer connection used to publish a validated snapshot to Neon:
#   GROWTHOS_WRITER_DSN=postgresql://writer@<host>/<db>?sslmode=verify-full
GROWTHOS_WRITER_DSN=
