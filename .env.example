# Private operator settings. Never store warehouse OAuth tokens here.
# Keep the actual .env Git-ignored and mode 0600; never paste its values into chat.
# Fill these two values in your private gwos-data/.env; use a bare hostname.
GROWTHOS_TRINO_HOST=
GROWTHOS_TRINO_USER=
GROWTHOS_TRINO_CATALOG=hive
GROWTHOS_TRINO_PORT=443
# Dedicated writer connection for atomic monthly replacement in Neon:
#   GROWTHOS_WRITER_DSN=postgresql://writer@<host>/<db>?sslmode=verify-full
GROWTHOS_WRITER_DSN=
